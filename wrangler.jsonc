{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "siteshift-ai",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Only the workers.dev URL is public; no per-version preview URLs.
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Workers AI (embeddings). Always runs remotely, even in local dev.
	"ai": {
		"binding": "AI"
	},
	// Vectorize has no local emulator; "remote": true lets local dev hit the real index.
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "siteshift-docs",
			"remote": true
		}
	],
	// Per-visitor limit on /api/ask: 10 requests per 60 seconds, keyed on CF-Connecting-IP.
	// namespace_id is an arbitrary integer, unique within the Cloudflare account.
	"ratelimits": [
		{
			"name": "ASK_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"vars": {
		"CLAUDE_MODEL": "claude-sonnet-5-5"
	}
}